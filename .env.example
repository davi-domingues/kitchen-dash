# Copie para .env (ignorado pelo git) ou exporte no seu terminal. Nunca commite valores.

# --- MCPs (ver docs/MCP.md) ---
# Token fine-grained do GitHub, restrito a este repositório
GITHUB_PAT=
# Opcional: chave do Context7 (sem ela funciona com limite menor)
CONTEXT7_API_KEY=

# --- Sentry (público: vai para o bundle, ver SYSTEM_DESIGN §7.3) ---
# Sem DSN o monitoramento fica desligado (no-op)
VITE_SENTRY_DSN=
# development, preview ou production
VITE_SENTRY_ENVIRONMENT=
# Opcional: versão do release (preenchida pelo CI)
VITE_SENTRY_RELEASE=
