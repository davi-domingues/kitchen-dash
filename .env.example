# Copie para .env (ignorado pelo git) ou exporte no seu terminal. Nunca commite valores.

# --- App (Vite) ---
# Variáveis VITE_* vão para o bundle e são PÚBLICAS: nunca coloque segredos aqui.
# Sem elas o jogo roda offline e as features online (login, ranking) ficam desligadas.
# Local: rode `supabase start` e use a API URL e a Publishable key que ele mostra.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Site key PÚBLICA do Cloudflare Turnstile. Para dev local use a chave de teste que sempre aprova:
# 1x00000000000000000000AA (a secret de teste vai só no shell do `supabase start`:
# SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA). Nunca coloque secret aqui.
VITE_TURNSTILE_SITE_KEY=

# --- MCPs (ver docs/MCP.md) ---
# Token fine-grained do GitHub, restrito a este repositório
GITHUB_PAT=
# Opcional: chave do Context7 (sem ela funciona com limite menor)
CONTEXT7_API_KEY=
