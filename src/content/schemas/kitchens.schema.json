{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kitchens.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kitchens"],
  "properties": {
    "kitchens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tiles", "legend", "spawns", "stoveBurnAfterMs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "tiles": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "string", "minLength": 3 }
          },
          "legend": {
            "type": "object",
            "propertyNames": { "minLength": 1, "maxLength": 1 },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {
                  "enum": ["wall", "floor", "crate", "cutting", "stove", "counter", "plates", "trash", "pass"]
                },
                "ingredient": { "type": "string" }
              },
              "if": { "properties": { "kind": { "const": "crate" } } },
              "then": { "required": ["ingredient"] },
              "else": { "not": { "required": ["ingredient"] } }
            }
          },
          "spawns": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "integer", "minimum": 0 }
            }
          },
          "stoveBurnAfterMs": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
