{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recipes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ingredients", "recipes"],
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "ms": { "type": "integer", "minimum": 0 }
  },
  "properties": {
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "emoji", "chopMs"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "emoji": { "type": "string", "minLength": 1 },
          "chopMs": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "emoji", "points", "unlockAtMs", "container", "ingredients", "cookMs"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "emoji": { "type": "string", "minLength": 1 },
          "points": { "type": "integer", "minimum": 1 },
          "unlockAtMs": { "$ref": "#/definitions/ms" },
          "container": { "enum": ["plate", "pot"] },
          "ingredients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "$ref": "#/definitions/id" }
          },
          "cookMs": { "$ref": "#/definitions/ms" }
        },
        "if": { "properties": { "container": { "const": "pot" } } },
        "then": { "properties": { "cookMs": { "minimum": 1 } } },
        "else": { "properties": { "cookMs": { "const": 0 } } }
      }
    }
  }
}
