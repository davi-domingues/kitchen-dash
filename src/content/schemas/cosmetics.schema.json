{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cosmetics.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["cosmetics"],
  "properties": {
    "cosmetics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slot", "unlockScore", "color"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "slot": { "enum": ["hat", "apron", "theme"] },
          "unlockScore": { "type": "integer", "minimum": 0 },
          "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
        }
      }
    }
  }
}
