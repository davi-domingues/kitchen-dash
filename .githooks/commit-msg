#!/bin/sh
# Valida Conventional Commits em PT-BR (ver AGENTS.md §2). Ative com: git config core.hooksPath .githooks
set -eu

header=$(head -n 1 "$1")

# Mensagens geradas pelo próprio git
case "$header" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *) exit 0 ;;
esac

tipos='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if ! printf '%s' "$header" | grep -Eq "^($tipos)(\([a-z0-9-]+\))?!?: [^ ].*[^.]$"; then
  echo "✖ Mensagem fora do padrão: tipo(escopo): descrição no imperativo" >&2
  echo "  Exemplo: feat(core): adiciona combo por entregas seguidas" >&2
  echo "  Tipos: $tipos  ·  sem ponto final" >&2
  echo "  Recebido: $header" >&2
  exit 1
fi

if [ "$(printf '%s' "$header" | wc -m)" -gt 72 ]; then
  echo "✖ Primeira linha com mais de 72 caracteres." >&2
  exit 1
fi
